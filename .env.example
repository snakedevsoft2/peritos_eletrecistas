# Variables de entorno del formulario de contacto (api/contact.js).
# En producción se configuran en Vercel → Project → Settings → Environment Variables.
# Para probar en local con `npx vercel dev`, copia este archivo como .env.local.

# Obligatoria: clave API de Brevo (Brevo → SMTP & API → API Keys)
BREVO_API_KEY=

# Opcionales
CONTACT_TO_EMAIL=electricidad2373@gmail.com
CONTACT_FROM_EMAIL=no-reply@peritoelectricistas.com
CONTACT_FROM_NAME=Web JS Electrical Services
